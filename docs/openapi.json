    },
    "/v1/approvals/{id}/revoke": {
      "post": {
        "tags": [
          "approvals"
        ],
        "summary": "Revoke Endpoint",
        "description": "Human action: Revokes an active or approved approval.",
        "operationId": "revoke_endpoint_v1_approvals__id__revoke_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
