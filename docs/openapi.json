        "description": "Queries actual executed tool calls. Used as verifiable evidence\nthat blocked actions never ran.",
        "operationId": "get_tool_calls_endpoint_v1_tool_calls_get",
        "parameters": [
          {
            "name": "tool",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tool"
            }
          },
          {
            "name": "audit_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Audit Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Tool Calls Endpoint V1 Tool Calls Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/reset": {
      "post": {
        "tags": [
          "demo"
        ],
        "summary": "Demo Reset Endpoint",
        "description": "Resets and re-seeds demo database. Disabled when DEMO_MODE != 1.",
        "operationId": "demo_reset_endpoint_v1_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Demo Reset Endpoint V1 Demo Reset Post"
                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/tamper": {
      "post": {
        "tags": [
          "demo"
        ],
        "summary": "Demo Tamper Endpoint",
        "description": "Directly alters a stored audit decision in SQL without updating hashes.\nDisabled when DEMO_MODE != 1.",
        "operationId": "demo_tamper_endpoint_v1_demo_tamper_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Demo Tamper Endpoint V1 Demo Tamper Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tests/results": {
      "get": {
        "tags": [
          "benchmarks"
        ],
        "summary": "Get Test Results Endpoint",
        "description": "Reads and serves benchmarks/results.json.\nReturns {'available': false} if the file has not yet been generated.",
        "operationId": "get_test_results_endpoint_v1_tests_results_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Test Results Endpoint V1 Tests Results Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "approved_params_json": {
            "type": "string",
            "title": "Approved Params Json"
          },
          "approved_hash": {
            "type": "string",
            "title": "Approved Hash"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "One of: 'pending', 'approved', 'rejected', 'used', 'revoked', 'expired'"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "approved_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "used_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Used At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "agent_id",
          "task_id",
          "tool",
          "approved_params_json",
          "approved_hash",
          "status",
          "created_at",
          "expires_at"
        ],
        "title": "Approval"
      },
      "ApprovalCreate": {
        "properties": {
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "task_id",
          "tool",
          "params"
        ],
        "title": "ApprovalCreate"
      },
      "AuditVerifyResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "checked": {
            "type": "integer",
            "title": "Checked"
          },
          "broken_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broken At"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "checked"
        ],
        "title": "AuditVerifyResponse"
      },
      "Decision": {
        "type": "string",
        "enum": [
          "ALLOW",
          "ASK_HUMAN",
          "BLOCK"
        ],
        "title": "Decision"
      },
      "ExecuteRequest": {
        "properties": {
          "agent_id": {
            "type": "string",
            "title": "Agent Id",
            "description": "Registered agent identifier, e.g. 'accounts-agent'"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "Active task identifier, e.g. 'task-accounts-1'"
          },
          "tool": {
            "type": "string",
            "title": "Tool",
            "description": "Tool name, e.g. 'payments.send'"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "description": "Tool parameters"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id",
            "description": "Pre-obtained approval ID, if any"
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "task_id",
          "tool"
        ],
        "title": "ExecuteRequest"
      },
      "ExecuteResponse": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "description": "Decision: ALLOW, ASK_HUMAN, or BLOCK"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Deterministic human-readable explanation"
          },
          "executed": {
            "type": "boolean",
            "title": "Executed",
            "description": "True only if tool actually executed",
            "default": false
          },
          "audit_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audit Id",
            "description": "Audit log record ID"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id",
            "description": "Approval ID if created or validated"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "reason"
        ],
        "title": "ExecuteResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Policy": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "condition_json": {
            "type": "string",
            "title": "Condition Json"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "default": 1
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "tool",
          "condition_json",
          "decision"
        ],
        "title": "Policy"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
