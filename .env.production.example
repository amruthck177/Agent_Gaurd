# ==============================================================================
# AgentGuard 2.0 Production Configuration Template
# ==============================================================================

# Server Port (assigned by host or container orchestrator)
PORT=8000

# Demo Mode (Set to 0 in strict production, 1 for hackathon / evaluation demo)
DEMO_MODE=1

# SQLite Database Location (use persistent volume path in containers)
AGENTGUARD_DB_PATH=/app/data/agentguard.db

# Static Files Directory (Frontend production bundle served directly by FastAPI)
STATIC_DIR=/app/static

# Approval Token Expiration Window (seconds)
APPROVAL_TTL_SECONDS=600

# Allowed CORS Origins (comma-separated list of origins permitted to call the API)
CORS_ORIGINS=https://your-domain.com,http://localhost:5173,http://localhost:8000

# Logging Level (INFO, WARNING, ERROR)
LOG_LEVEL=INFO
