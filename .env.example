# AgentGuard environment variables
# Copy to .env and fill in values before running.

# Set to 1 to enable the /v1/demo/* endpoints (demo panel, reset, tamper).
# Never set to 1 in a real deployment.
DEMO_MODE=1

# Default approval lifetime in seconds (plan.md C6: 10 minutes).
APPROVAL_TTL_SECONDS=600

# SQLite database file path (relative to the backend/ working directory).
DB_PATH=agentguard.db
